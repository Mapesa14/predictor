# Service configuration. Copy to `.env` (git-ignored) and fill in.
#
# Everything here is read by the *service* - the Python API - and never by the
# web or phone build. Do NOT put LIVE_API_KEY in web/.env or in any variable
# whose name starts with VITE_: Vite inlines those into the JavaScript bundle,
# which every browser downloads and every copy of the phone app carries.
#
# docker compose reads this file automatically. For a plain local run, export
# the variables in your shell before starting uvicorn.

# --- live scores (API-Football / api-sports.io) ------------------------------
# Your dashboard key. Leave empty and live scores stay off; nothing else is
# affected. The API calls the provider only while a match we carry is in play,
# one request per poll, inside a budget ledger - see service/live.py.
LIVE_API_KEY=

# The plan's caps. Leave at the free tier's unless you have upgraded.
# LIVE_DAILY_LIMIT=100
# LIVE_MINUTE_LIMIT=10
# Never spend the last N requests of the rolling 24 hours.
# LIVE_RESERVE=10
# Floor between polls while a match is in play.
# LIVE_MIN_INTERVAL_S=180
# Keep only these API-Football league ids (comma-separated). Find ids with:
#   python predict.py live-leagues tanzania
# LIVE_LEAGUES=

# --- match data --------------------------------------------------------------
# The European pool (football-data.co.uk results + fixtures feed), mounted into
# the container at /data/soccer. Point this at the folder you already have -
# forward slashes are fine on Windows. Leave it unset and compose creates
# ./soccerdata, which you can fill with:
#   docker compose exec api python predict.py update --since 2023
# Without it the service runs on the bundled divisions alone - no European
# leagues - and /api/health lists them under data.missing_top10.
# SOCCER_DATA_DIR=D:/Downloads July 2026/SoccerData

# --- storage -----------------------------------------------------------------
# Unset = files on disk, for a single machine. Set = Postgres for the record,
# accounts, and the live-score budget ledger. Needed for more than one worker.
# Switching on an existing record? Run once:  python predict.py record-migrate
# DATABASE_URL=postgresql://predictor:change-me@localhost:5432/predictor
POSTGRES_PASSWORD=change-me

# Where the record (and, without a database, the live budget ledger) is kept.
# In a deployment this must be a persistent volume.
# RECORD_ROOT=/var/lib/predictor
